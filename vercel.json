{
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/:path*",
      "destination": "/api/[...route].js"
    },
    {
      "source": "/oauth/:path*",
      "destination": "/api/[...route].js"
    },
    {
      "source": "/mcp",
      "destination": "/api/[...route].js"
    },
    {
      "source": "/mcp/:path*",
      "destination": "/api/[...route].js"
    },
    {
      "source": "/api/youtube-edge",
      "destination": "/api/youtube-edge"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/[...route].js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/youtube-edge.js": {
      "maxDuration": 25
    },
    "api/**/*.js": {
      "maxDuration": 60,
      "includeFiles": "backend/src/{routes,middleware,db,utils,services}/**",
      "excludeFiles": "{node_modules/kokoro-js,node_modules/@huggingface,node_modules/onnxruntime-*,node_modules/@hocuspocus,node_modules/@ffmpeg,node_modules/sharp,node_modules/canvas}/**"
    }
  },
  "outputDirectory": "dist"
}