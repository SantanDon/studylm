
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
YOUTUBE_INNERTUBE_API_KEY=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DATABASE_INIT_TIMEOUT_MS=30000
LWC_SECRET=
LWC_ALLOWED_ORIGINS=

# Optional Supadata timestamped YouTube fallback (server-side only)
# Keep empty to use StudyPod's native/open-source-first extraction chain.
SUPADATA_API_KEY=
SUPADATA_TRANSCRIPT_MODE=native
SUPADATA_TRANSCRIPT_LANGUAGE=en
SUPADATA_METADATA_ENABLED=true
SUPADATA_PREFER=0
SUPADATA_TIMEOUT_MS=30000
SUPADATA_JOB_TIMEOUT_MS=120000
SUPADATA_JOB_POLL_MS=2500
SUPADATA_CHUNK_SIZE=1000

# Optional open-source yt-dlp caption fallback.
# Native InnerTube remains first. Enable this in runtimes where yt-dlp is installed.
YTDLP_TRANSCRIPT_ENABLED=0
YTDLP_COMMAND=
YTDLP_COMMAND_ARGS=
YTDLP_TIMEOUT_MS=90000
